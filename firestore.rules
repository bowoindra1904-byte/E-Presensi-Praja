rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Pegawai Satpol PP
    match /employees/{employeeId} {
      allow read, write: if true;
    }
    
    // Slot Pos Lokasi Dinas
    match /locations/{locationId} {
      allow read, write: if true;
    }
    
    // Rekapitulasi Presensi Masuk & Pulang
    match /attendance/{recordId} {
      allow read, write: if true;
    }

    // Permohonan Izin & Sakit Pegawai (Leave Requests)
    match /leave_requests/{requestId} {
      allow read, write: if true;
    }
    
    // Log Audit Keamanan
    match /security_logs/{logId} {
      allow read, write: if true;
    }
    
    // Pengaturan Sistem & PIN
    match /system_settings/{settingId} {
      allow read, write: if true;
    }

    // Hari Libur Custom & Tanggal Merah Tambahan
    match /custom_holidays/{holidayId} {
      allow read, write: if true;
    }

    // Akun Multi-Admin (1 Komando Pusat + 4 Danru)
    match /admin_accounts/{adminId} {
      allow read, write: if true;
    }

    // Health check test doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
